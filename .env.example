# ---------- Browser (safe to expose; access is protected by Firestore rules) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloudinary (free tier) — UNSIGNED upload preset; allow jpg,png,webp,gif,pdf,mp4,mov,webm (Media studio saves posters + videos)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Public site URL used in QR codes / share links (no trailing slash)
VITE_SITE_URL=https://amal-club.vercel.app

# ---------- Server only (Vercel → Settings → Environment Variables). NEVER prefix with VITE_ ----------
# Firebase service account JSON (Project settings → Service accounts → Generate key), pasted as one line
FIREBASE_SERVICE_ACCOUNT=
# AI providers — order = fallback chain; the first is primary
AI_TEXT_PROVIDERS=gemini,groq,openrouter
AI_IMAGE_PROVIDERS=gemini,cloudflare,pollinations
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
UNSPLASH_ACCESS_KEY=
# Canva Connect (Media studio) — canva.com/developers → your integration → Client ID / secret
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Optional: only if your Canva redirect URL isn't <SITE_URL>/api/canva/callback
# CANVA_REDIRECT_URI=
# Optional: public site URL for the server (defaults to the request host)
# SITE_URL=https://amal-club.vercel.app
# Optional: self-host the ffmpeg.wasm core instead of jsDelivr/unpkg (folder with ffmpeg-core.js + .wasm)
# VITE_FFMPEG_BASE=
# Protects the daily cleanup job (Vercel sends it automatically)
CRON_SECRET=
