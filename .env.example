# ---------- Browser (safe to expose; access is protected by Firestore rules) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloudinary (free tier) — create an UNSIGNED upload preset limited to images
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Public site URL used in QR codes / share links (no trailing slash)
VITE_SITE_URL=https://amal-club.vercel.app

# ---------- Server only (Vercel → Settings → Environment Variables). NEVER prefix with VITE_ ----------
# Firebase service account JSON (Project settings → Service accounts → Generate key), pasted as one line
FIREBASE_SERVICE_ACCOUNT=
# AI providers — order = fallback chain; the first is primary
AI_TEXT_PROVIDERS=gemini,groq,openrouter
AI_IMAGE_PROVIDERS=gemini,cloudflare,pollinations
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
UNSPLASH_ACCESS_KEY=
# Protects the daily cleanup job (Vercel sends it automatically)
CRON_SECRET=
